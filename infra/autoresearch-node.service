[Unit]
Description=Autoresearch node agent (starts gVisor sandboxes)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStartPre=/usr/local/bin/autoresearch-node-token
EnvironmentFile=-/etc/autoresearch/node.env
Environment=NODE_BACKEND=docker NODE_SLOTS=3 DOCKER_RUNTIME=runsc
WorkingDirectory=/opt/autoresearch
ExecStart=/opt/autoresearch/.venv-node/bin/uvicorn node_agent.app:app --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
